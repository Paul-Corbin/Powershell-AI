<Window x:Class="PowershellAI.OutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PowershellAI"
        mc:Ignorable="d"
        Title="Powershell AI" Height="205" Width="600" Top="10" ResizeMode="NoResize" WindowStyle="None" Topmost="True" WindowStartupLocation="CenterScreen" Background="{x:Null}" Foreground="{x:Null}">
    <DockPanel LastChildFill="False" Margin="0,0,0,0">
        <Border DockPanel.Dock="Top" Height="25">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF404040"/>
                    <GradientStop Color="#FF3E3E3E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid x:Name="TopBar" Height="25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition Width="5"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="MinimizeButton" Click="MinimizeClick" Panel.ZIndex="1" Background="{x:Null}" Foreground="{x:Null}" FontSize="20" BorderBrush="{x:Null}" Grid.Column="1" Width="25" Height="25" TabIndex="2147483646">
                    <TextBlock x:Name="MinimizeBackground" TextWrapping="NoWrap" Text="-" Grid.Column="1" TextAlignment="Center" Foreground="White" FontSize="36" LineHeight="9" Margin="0,-8,0,0" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="CloseButton" Click="CloseClick" Grid.Column="3" Background="{x:Null}" FontSize="24" BorderBrush="{x:Null}" Width="25" Height="25" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <TextBlock x:Name="CloseBackground" TextWrapping="NoWrap" Text="x" Grid.Column="3" Cursor="" TextAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,5"/>
                </Button>
                <TextBlock x:Name="Title" MouseLeftButtonDown="TopBarDown" TextWrapping="Wrap" Text='   Powershell AI' Foreground="#FFB7B7B7" FontWeight="Bold" FontSize="16"/>
            </Grid>

        </Border>
        <Border Width="600">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF272727"/>
                    <GradientStop Color="#FF1D1D1D" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid x:Name="OutputGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="ReferencesScroll" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto" Padding="5,1,5,5" Grid.Row="1" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Grid x:Name="References" Margin="0,-5,0,0">
                        <Grid.RowDefinitions>
                        </Grid.RowDefinitions>
                    </Grid>

                </ScrollViewer>
                <Grid x:Name="ControlGrid1" Margin="5,5,5,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SendButton1" Content="Send" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="0,0,0,0" Foreground="#FFB7B7B7" FontSize="16" BorderBrush="{x:Null}" Width="55" Margin="5,0,0,0" Grid.Column="3" Height="30" TabIndex="2" BorderThickness="0,0,0,0">
                        <Button.Background>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#FF2F2F2F"/>
                                <GradientStop Color="#FF353535" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    <Rectangle x:Name="CommandBackground1" HorizontalAlignment="Center" VerticalAlignment="Top" Height="30" StrokeThickness="0" Width="470">
                        <Rectangle.Fill>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#FF2F2F2F"/>
                                <GradientStop Color="#FF353535" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBox Text="Write-Host &quot;Hello, World!&quot;" FontSize="16" x:Name="CommandBlock1" HorizontalAlignment="Center" Margin="5,0,5,0" Panel.ZIndex="2" Foreground="#FFB7B7B7" Background="{x:Null}" Width="460" IsReadOnly="True" MaxLines="1" BorderBrush="{x:Null}" BorderThickness="0,0,0,0"/>
                    <Button x:Name="CopyButton1" Content="Copy" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="0,0,0,0" Foreground="#FFB7B7B7" FontSize="16" BorderBrush="{x:Null}" Margin="5,0,0,0" Grid.Column="1" Height="30" Width="55" TabIndex="1" BorderThickness="0,0,0,0">
                        <Button.Background>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#FF2F2F2F"/>
                                <GradientStop Color="#FF353535" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </DockPanel>
</Window>
