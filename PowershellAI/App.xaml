<Application x:Class="PowershellAI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PowershellAI"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             Startup="Application_Startup">

    <Application.Resources>
        <tb:TaskbarIcon x:Key="TrayIcon" ToolTipText="Powershell AI" TrayRightMouseUp="ShowMenu">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Exit" Click="ExitClick"/>
                    <MenuItem Header="Settings">
                        <MenuItem Header ="Change API Key" Click="UpdateApiKey"/>
                        <MenuItem Header ="Delete API Key" Click="DeleteApiKey"/>
                    </MenuItem>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Application.Resources>
</Application>
