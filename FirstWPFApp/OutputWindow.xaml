<Window x:Name="OutputWindow" x:Class="WpfApp1.AWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Powershell AI" Height="90" Width="700" Top="10" ResizeMode="NoResize" WindowStyle="None" Topmost="True" WindowStartupLocation="CenterScreen" Background="{x:Null}" Foreground="{x:Null}">
    <DockPanel LastChildFill="False" Margin="0,0,0,0">
        <Border DockPanel.Dock="Top" Height="20" Width="700">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF404040"/>
                    <GradientStop Color="#FF3E3E3E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid x:Name="TopBar">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="5"/>
                </Grid.ColumnDefinitions>
                <Rectangle x:Name="TopBarBackground" Grid.ColumnSpan="4" Fill="#FF3A3A3A"/>
                <Button x:Name="MinimizeButton" Panel.ZIndex="2" Grid.Column="1" Background="{x:Null}" Foreground="{x:Null}" FontSize="20" Margin="1,1,1,1" BorderBrush="{x:Null}"/>
                <Button x:Name="CloseButton" Content="" Panel.ZIndex="2" Grid.Column="3" Background="{x:Null}" Foreground="{x:Null}" FontSize="20" Margin="1,1,1,1" BorderBrush="{x:Null}"/>
                <TextBlock x:Name="MinimizeBackground" Text="-" Grid.Column="1" Panel.ZIndex="1" TextAlignment="Center" Foreground="White" FontSize="24" LineHeight="9" TextWrapping="Wrap" Margin="0,-9,0,0"/>
                <TextBlock x:Name="CloseBackground" Text="x" Grid.Column="3" Panel.ZIndex="1" Cursor="" TextAlignment="Center" Foreground="White" FontWeight="Bold"/>
                <TextBlock x:Name="Title" TextWrapping="Wrap" Text='Powershell AI' Foreground="#FFB7B7B7" Margin="5,2,0,2" FontWeight="Bold"/>
            </Grid>

        </Border>
        <Border>
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF272727"/>
                    <GradientStop Color="#FF1D1D1D" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid x:Name="ControlGrid" Margin="10,10,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="550"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="SubmitButton" Content="Submit" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="0,0,0,0" Foreground="#FFB7B7B7" FontSize="24" BorderBrush="{x:Null}" Grid.Column="1" Width="120" Margin="10,-1,0,0" Height="52">
                    <Button.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="#FF2F2F2F"/>
                            <GradientStop Color="#FF353535" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
                <Rectangle x:Name="InputBackground" HorizontalAlignment="Left" VerticalAlignment="Top" Width="550" Height="50" StrokeThickness="0">
                    <Rectangle.Fill>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="#FF2F2F2F"/>
                            <GradientStop Color="#FF353535" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <TextBox TextWrapping="Wrap" Text="Enter command" FontSize="24" x:Name="InputBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,5,0,0" Width="540" Height="40" Panel.ZIndex="2" Foreground="#FFB7B7B7" Background="{x:Null}" BorderBrush="{x:Null}"/>
            </Grid>

        </Border>
    </DockPanel>
</Window>
